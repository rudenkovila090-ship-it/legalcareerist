# Скопируйте в .env (локально) или задайте как переменные окружения на хостинге. Файл .env в git не попадает.

# --- Instagram / Meta (см. docs/INSTAGRAM_SETUP.md) ---
# ID профессионального Instagram-аккаунта (user_id из ответа на выпуск токена, он же entry.id в вебхуках)
IG_ACCOUNT_ID=
# Долгоживущий токен Instagram (60 дней; мост продлевает его сам и хранит свежий в БД)
IG_ACCESS_TOKEN=
# App Secret приложения Meta (Settings -> Basic) — нужен для проверки подписи вебхуков
IG_APP_SECRET=
# Любая длинная случайная строка; ту же строку вводите в поле «Verify token» при настройке вебхука
IG_VERIFY_TOKEN=

# --- Telegram: @LegalcareeristBot отправляет заявки менеджеру ---
# Токен от BotFather (тот же, что у работающего бота; мост только отправляет сообщения)
TELEGRAM_BOT_TOKEN=
# ID чата/группы менеджеров (для групп начинается с -100…)
TELEGRAM_MANAGER_CHAT_ID=

# --- Ссылки для текстов в config/flows.json ---
BOT_URL=https://t.me/LegalcareeristBot
SITE_URL=
# Правила, которым нужна незаданная ссылка (оплата, сайт), автоматически отключаются
PAYMENT_URL=

# --- Необязательное ---
# GRAPH_API_VERSION=v23.0
# DB_PATH=data/bridge.db          # на хостинге положите на постоянный диск (volume)
# HUMAN_MODE_HOURS=12             # сколько часов бот молчит после «менеджер»
# NOTIFY_COMMENT_LEADS=false      # true — присылать менеджеру и каждый комментарий с ключевым словом
# LOG_LEVEL=INFO
