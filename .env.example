# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Твой Telegram ID (узнать: написать боту /myid). Бот отвечает только тебе.
OWNER_TELEGRAM_ID=

# --- Google Таблица ---
# ID из ссылки: docs.google.com/spreadsheets/d/<ЭТОТ_ID>/edit
SPREADSHEET_ID=
# Ключ сервис-аккаунта: либо содержимое JSON одной строкой, либо путь к файлу
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Claude ---
ANTHROPIC_API_KEY=
# Модель можно сменить, чтобы снизить стоимость: claude-sonnet-5-5 или claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
# Если запрос отклонён фильтрами безопасности, API повторит его на запасной модели
CLAUDE_FALLBACKS=1

# --- Расписание (по часовому поясу TIMEZONE) ---
TIMEZONE=Europe/Moscow
MORNING_TIME=09:00
EVENING_TIME=21:00
WEEK_PLAN_TIME=09:05
WEEK_REVIEW_TIME=20:00
# Через сколько дней напоминать человеку, у которого не назначен срок шага
FOLLOWUP_DAYS=5
