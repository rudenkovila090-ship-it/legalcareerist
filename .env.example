# Скопируйте в .env (локально) или задайте как переменные окружения на хостинге. Файл .env в git не попадает.

# ============================================================
# Telegram-бот приёма заявок (основной путь), см. docs/TELEGRAM_BOT.md
# ============================================================
# Токен от BotFather
TELEGRAM_BOT_TOKEN=
# ID группы менеджеров (начинается с -100…). Узнать: python -m bridge.tgbot --find-chat
TELEGRAM_MANAGER_CHAT_ID=
# Ссылка на политику обработки персональных данных. Задана — бот запрашивает согласие до сбора контактов
PRIVACY_URL=

# Канал, на который нужно подписаться, чтобы получить материал (воронки с gate). Бот должен быть администратором канала.
# Пусто — подписку не проверяем, материалы выдаются сразу.
SUBSCRIBE_CHANNEL=
# CHANNEL_URL=                    # ссылка для кнопки «Подписаться», если канал приватный; для @имени строится сама

# Чат сообщества. Задан: при отписке (путь с обратной связью) бот удалит человека из чата.
# Бот должен быть администратором чата. Пусто: бот только передаёт заявку менеджеру.
COMMUNITY_CHAT_ID=

BOT_URL=https://t.me/LegalcareeristBot
SITE_URL=
PAYMENT_URL=

# DB_PATH=data/bridge.db          # заявки и состояния диалогов; на хостинге положите на постоянный диск
# HUMAN_MODE_HOURS=12             # сколько часов бот молчит после «менеджер» или ответа менеджера
# TG_FORCE_POLLING=0              # 1 — удалить чужой webhook бота (старый процесс перестанет получать сообщения!)
# LOG_LEVEL=INFO

# ============================================================
# Instagram-мост (официальный Instagram API), см. docs/INSTAGRAM_SETUP.md
# Для запуска только Telegram-бота (python -m bridge.tgbot) эти переменные НЕ нужны
# ============================================================
# Адрес сервера для HTTPS (docker compose): bridge.example.com или <IP-через-дефисы>.sslip.io
DOMAIN=
# ID Instagram-аккаунта (страница «Настройка API для входа в Instagram», рядом с именем аккаунта)
IG_ACCOUNT_ID=
# Токен доступа из блока «Сгенерируйте маркеры доступа»
IG_ACCESS_TOKEN=
# Секреты через запятую: «Секрет приложения Instagram» и «Секрет приложения» (Настройки приложения → Основное).
# Meta подписывает вебхуки одним из них, мост принимает оба.
IG_APP_SECRET=
# Любая длинная случайная строка (например: openssl rand -hex 24); ту же введёте в поле Verify token в Meta
IG_VERIFY_TOKEN=
# GRAPH_API_VERSION=v23.0
# NOTIFY_COMMENT_LEADS=false      # true: присылать менеджеру каждый комментарий с ключевым словом
# TELEGRAM_POLLING=1              # 0: не опрашивать Telegram (тогда ответы менеджеров из Telegram в Instagram не работают)
# SUBSCRIPTION_PATH=config/subscription.json   # тексты сообщений о подписке
