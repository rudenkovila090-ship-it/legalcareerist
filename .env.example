# Скопируйте в .env (локально) или задайте как переменные окружения на хостинге. Файл .env в git не попадает.

# ============================================================
# Telegram-бот приёма заявок (основной путь), см. docs/TELEGRAM_BOT.md
# ============================================================
# Токен от BotFather
TELEGRAM_BOT_TOKEN=
# ID группы менеджеров (начинается с -100…). Узнать: python -m bridge.tgbot --find-chat
TELEGRAM_MANAGER_CHAT_ID=
# Ссылка на политику обработки персональных данных. Задана — бот запрашивает согласие до сбора контактов
PRIVACY_URL=

BOT_URL=https://t.me/LegalcareeristBot
SITE_URL=
PAYMENT_URL=

# DB_PATH=data/bridge.db          # заявки и состояния диалогов; на хостинге положите на постоянный диск
# HUMAN_MODE_HOURS=12             # сколько часов бот молчит после «менеджер» или ответа менеджера
# TG_FORCE_POLLING=0              # 1 — удалить чужой webhook бота (старый процесс перестанет получать сообщения!)
# LOG_LEVEL=INFO

# ============================================================
# Instagram-мост (только для официального Instagram API), см. docs/INSTAGRAM_SETUP.md
# Для запуска Telegram-бота НЕ нужен
# ============================================================
# IG_ACCOUNT_ID=
# IG_ACCESS_TOKEN=
# Секрет приложения Meta; можно указать два через запятую: «секрет приложения» и «секрет Instagram-приложения»
# IG_APP_SECRET=
# IG_VERIFY_TOKEN=
# GRAPH_API_VERSION=v23.0
# NOTIFY_COMMENT_LEADS=false
