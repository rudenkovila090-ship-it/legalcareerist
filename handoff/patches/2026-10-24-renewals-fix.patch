---
 server/index.js              | 2 +-
 server/lib/accountProfile.js | 2 +-
 server/lib/adminCabinet.js   | 2 +-
 server/lib/store.js          | 7 +++++--
 4 files changed, 8 insertions(+), 5 deletions(-)

diff --git a/server/index.js b/server/index.js
index 4bbb951..0c5106f 100644
--- a/server/index.js
+++ b/server/index.js
@@ -3520,7 +3520,7 @@ async function processReviewFlow() {
   reviewFlowRunning = true
   try {
     for (const j of listJoins()) {
-      if (!j.paid || !j.tgUserId || j.status !== 'active' || !j.firstPaidAt) continue
+      if (!j.paid || !j.tgUserId || j.status !== 'active' || !j.firstPaidAt || j.importedFromBotHelp) continue // перенесённым просьбу об отзыве уже присылал BotHelp
       const age = now - j.firstPaidAt
       if (!j.reviewAskedAt && age >= 30 * DAY && age <= 60 * DAY && hour >= 10 && hour < 21) {
         setJoinField(j.token, 'reviewAskedAt', now)
diff --git a/server/lib/accountProfile.js b/server/lib/accountProfile.js
index a048852..fe527b4 100644
--- a/server/lib/accountProfile.js
+++ b/server/lib/accountProfile.js
@@ -59,7 +59,7 @@ export function subscriptionDetails(tgId, email = '', now = Date.now()) {
   const tariff = TARIFFS[join.tariffId]
   const payments = (join.payments ?? [])
     .filter((p) => Number(p.amount) > 0 || p.estimated)
-    .map((p) => ({ amount: Number(p.amount) || null, paidAt: Number(p.paidAt) || null, estimated: Boolean(p.estimated) }))
+    .map((p) => ({ amount: Number(p.amount) || null, paidAt: Number(p.at ?? p.paidAt) || null, estimated: Boolean(p.estimated) }))
     .sort((a, b) => (b.paidAt ?? 0) - (a.paidAt ?? 0))
     .slice(0, 50)
   const renews = status.status === 'active' && status.autoRenew
diff --git a/server/lib/adminCabinet.js b/server/lib/adminCabinet.js
index df87ad7..d1e93f7 100644
--- a/server/lib/adminCabinet.js
+++ b/server/lib/adminCabinet.js
@@ -281,7 +281,7 @@ export function cancelledScreen(joins, tariffs = {}) {
  */
 export function reminderTargets(joins, now, days) {
   const day = mskDayKey(now + days * DAY)
-  const due = joins.filter((j) => j.status === 'active' && j.nextPaymentAt && mskDayKey(j.nextPaymentAt) === day)
+  const due = joins.filter((j) => j.status === 'active' && !j.oneTime && j.nextPaymentAt && mskDayKey(j.nextPaymentAt) === day) // у разовых списания нет, им пишет processExpiry
   const fresh = due.filter((j) => j.remindedFor !== `${j.nextPaymentAt}:${days}`)
   return {
     day,
