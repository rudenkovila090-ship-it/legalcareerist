new file mode 100644
index 0000000..5ea5a13
--- /dev/null
+++ b/server/lib/communityReviews.js
@@ -0,0 +1,103 @@
+// Отзывы резидентов о сообществе и бонус «+4 дня» за них. Человек оставляет отзыв на Яндексе (REVIEW_URL), нажимает
+// «Я оставил(а) отзыв» и присылает боту текст или скриншот. Бот пересылает это админу, а бонус начисляется только после
+// решения админа кнопкой. Записи: id → { joinToken, tgUserId, name, telegram, text, hasPhoto, status, createdAt, decidedAt }.
+import { createJsonStore } from './jsonStore.js'
+
+const store = createJsonStore('community-reviews.json')
+
+/** Страница организации на Яндексе: на неё ведёт кнопка «Оставить отзыв». Можно заменить в server/.env: FEEDBACK_URL. */
+export const REVIEW_URL = process.env.FEEDBACK_URL || 'https://yandex.ru/profile/97325553975'
+export const REVIEW_BONUS_DAYS = 4
+
+const MSK = 'Europe/Moscow'
+const ruDate = (ts) => new Intl.DateTimeFormat('ru-RU', { timeZone: MSK, day: '2-digit', month: '2-digit', year: 'numeric' }).format(new Date(ts))
+const clip = (text, max) => (text.length > max ? `${text.slice(0, max).trimEnd()}…` : text)
+
+export function addCommunityReview({ joinToken, tgUserId, name, telegram, text, hasPhoto }) {
+  return store.create({ joinToken, tgUserId: String(tgUserId), name: name || '', telegram: telegram || '', text: String(text ?? '').trim(), hasPhoto: Boolean(hasPhoto), status: 'new' })
+}
+
+export function getCommunityReview(id) {
+  const rec = store.get(id)
+  return rec ? { id, ...rec } : null
+}
+
+export function listCommunityReviews() {
+  return store.all().map(({ token, ...rec }) => ({ id: token, ...rec }))
+}
+
+/** Решение админа. Меняет только запись, ждущую решения: повторное нажатие кнопки ничего не делает (null). */
+export function decideCommunityReview(id, status) {
+  let result = null
+  store.update(id, (rec) => {
+    if (rec.status !== 'new') return rec
+    result = { id, ...rec, status, decidedAt: Date.now() }
+    return { ...rec, status, decidedAt: result.decidedAt }
+  })
+  return result
+}
+
+const nameOf = (r) => [r.name && r.name !== '—' ? r.name : null, r.telegram || null, r.tgUserId ? `…${String(r.tgUserId).slice(-4)}` : null].filter(Boolean).join(', ') || 'без имени'
+const joinName = (j) => [j.name && j.name !== '—' ? j.name : null, j.telegram || null, j.tgUserId ? `…${String(j.tgUserId).slice(-4)}` : null].filter(Boolean).join(', ') || 'без имени'
+const quote = (r, max) => (r.text ? `«${clip(r.text.replace(/\s+/g, ' '), max)}»` : r.hasPhoto ? '(только скриншот, он был в чате с ботом)' : '(без текста)')
+
+const backRow = [{ text: '⬅️ Сообщество', callback_data: 'a:sec:community' }, { text: '🏠 Меню', callback_data: 'a:menu' }]
+
+/** Кому и за что начислены дни: ждут решения, решения админа и бонусы, выданные автоматически до проверки отзывов. */
+export function communityReviewsScreen(joins, reviews) {
+  const byJoin = new Set(reviews.filter((r) => r.status === 'approved').map((r) => r.joinToken))
+  const pending = reviews.filter((r) => r.status === 'new').sort((a, b) => a.createdAt - b.createdAt)
+  const approved = reviews.filter((r) => r.status === 'approved').sort((a, b) => (b.decidedAt ?? 0) - (a.decidedAt ?? 0))
+  const rejected = reviews.filter((r) => r.status === 'rejected').sort((a, b) => (b.decidedAt ?? 0) - (a.decidedAt ?? 0))
+  // До проверки отзывов бонус начислялся сам через 5 часов после просьбы, текст не сохранялся.
+  const legacy = joins.filter((j) => j.reviewThankedAt && !byJoin.has(j.token)).sort((a, b) => (a.reviewThankedAt ?? 0) - (b.reviewThankedAt ?? 0))
+  const asked = joins.filter((j) => j.reviewAskedAt && !j.reviewThankedAt && !reviews.some((r) => r.joinToken === j.token))
+
+  const lines = ['⭐ Отзывы и бонусы за отзыв', '']
+  lines.push(`Ждут вашего решения: ${pending.length}`)
+  for (const r of pending) lines.push(`• ${nameOf(r)} · ${ruDate(r.createdAt)}`, `   ${quote(r, 500)}`)
+  if (approved.length) {
+    lines.push('', `✅ Начислено +${REVIEW_BONUS_DAYS} дня после проверки: ${approved.length}`)
+    for (const r of approved) lines.push(`• ${nameOf(r)} · ${ruDate(r.decidedAt ?? r.createdAt)}`, `   ${quote(r, 300)}`)
+  }
+  if (rejected.length) {
+    lines.push('', `❌ Не начислено: ${rejected.length}`)
+    for (const r of rejected) lines.push(`• ${nameOf(r)} · ${ruDate(r.decidedAt ?? r.createdAt)}`, `   ${quote(r, 300)}`)
+  }
+  if (legacy.length) {
+    lines.push('', `🎁 Начислено автоматически, без проверки отзыва (так работал бот до проверки отзывов): ${legacy.length}`, 'Текст отзыва тогда не сохранялся, проверьте по Яндексу:')
+    for (const j of legacy) lines.push(`• ${joinName(j)} · просили ${j.reviewAskedAt ? ruDate(j.reviewAskedAt) : '—'}, начислено ${ruDate(j.reviewThankedAt)}${j.bonusDays ? ` · бонус +${j.bonusDays} дн.` : ''}`)
+  }
+  if (asked.length) lines.push('', `Просили отзыв, ответа пока нет: ${asked.length}`)
+  if (!reviews.length && !legacy.length && !asked.length) lines.push('', 'Пока никто не присылал отзыв, и просьб об отзыве ещё не было.')
+  lines.push('', `Отзыв оставляют на Яндексе: ${REVIEW_URL}`)
+
+  const keyboard = pending.slice(0, 8).map((r) => [
+    { text: `✅ +${REVIEW_BONUS_DAYS} дня: ${nameOf(r)}`.slice(0, 40), callback_data: `a:x:rvok:${r.id}` },
+    { text: '❌ Нет', callback_data: `a:x:rvno:${r.id}` },
+  ])
+  return { text: lines.join('\n'), keyboard: [...keyboard, backRow] }
+}
+
+/** Сообщение админу о присланном отзыве: кто, какая подписка, сам текст и кнопки решения. */
+export function reviewForAdmin({ review, join }) {
+  const lines = [
+    '⭐ Новый отзыв о сообществе',
+    '',
+    `👤 ${nameOf(review)}`,
+    join?.nextPaymentAt ? `📋 Подписка: ${join.oneTime ? 'разовая' : 'с автопродлением'}, следующее списание ${ruDate(join.nextPaymentAt)}` : null,
+    join?.reviewThankedAt ? `⚠️ Бонус за отзыв этому человеку уже начислялся ${ruDate(join.reviewThankedAt)}` : null,
+    '',
+    review.text ? `«${review.text}»` : null,
+    review.hasPhoto ? (review.text ? '📎 Скриншот в сообщении выше' : '📎 Только скриншот — он в сообщении выше') : null,
+    '',
+    `Проверьте отзыв на Яндексе (${REVIEW_URL}) и решите, начислять ли +${REVIEW_BONUS_DAYS} дня.`,
+  ].filter((l) => l !== null)
+  return {
+    text: lines.join('\n'),
+    keyboard: [
+      [{ text: `✅ Начислить +${REVIEW_BONUS_DAYS} дня`, callback_data: `a:x:rvok:${review.id}` }, { text: '❌ Не начислять', callback_data: `a:x:rvno:${review.id}` }],
+      [{ text: '👤 Карточка человека', callback_data: `a:x:pc:${review.tgUserId}` }],
+    ],
+  }
+}
