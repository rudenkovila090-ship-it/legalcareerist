# Скопируйте этот файл в .env на сервере и заполните реальными значениями.
# .env НЕ коммитится в git (см. .gitignore).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
PRODAMUS_DOMAIN=legalcareerist.payform.ru
PRODAMUS_SECRET_KEY=
SITE_URL=https://legalcareerist.ru
COMMUNITY_INVITE_LINK=
# Ссылки на материалы маркетплейса — что открывается в личном кабинете
# после оплаты (см. server/lib/prodamus.js MATERIALS)
LONGLIST_EVENTS_ACCESS_URL=
GUIDE_NOTARIAT_ACCESS_URL=
GUIDE_GRANTS_ACCESS_URL=
PORT=3001
# Почта для писем клиентам (материал после оплаты, подтверждение билета).
# Не заполнено — письма не уходят, остальное (Telegram, кабинет на сайте) работает.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Отдельные платёжные страницы Prodamus (необязательно). Не заданы — используется основная (PRODAMUS_DOMAIN).
# Проще всего записать скриптом: bash scripts/setup-prodamus.sh materials  (или events)
PRODAMUS_MATERIALS_DOMAIN=
PRODAMUS_MATERIALS_SECRET_KEY=
PRODAMUS_EVENTS_DOMAIN=
PRODAMUS_EVENTS_SECRET_KEY=
# Сроки хранения персональных данных (см. docs/personal-data-map.md, раздел 7).
# По умолчанию бот каждый день в 04:00 МСК присылает админу отчёт с кнопкой «Удалить сейчас».
# RETENTION_AUTO=1 — удалять просроченные данные сам, без подтверждения (включайте, когда убедитесь по отчётам, что сроки верны).
RETENTION_AUTO=
