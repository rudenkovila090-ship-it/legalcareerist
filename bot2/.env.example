# Второй бот (бывший бот из BotHelp). Секреты — только здесь, в репозиторий этот файл не попадает.
# Токен вписывается скриптом на сервере, в чат и в git его не отправляйте.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Платёжная страница Prodamus, где заведены подписки (та же, что у основного сайта), и её секретный ключ.
PRODAMUS_DOMAIN=legalcareerist.payform.ru
PRODAMUS_SECRET_KEY=
# Публичный адрес второго бота: туда Prodamus присылает уведомления об оплатах (nginx пересылает /bot2/ на порт бота).
SITE_URL=https://legalcareerist.ru
BOT2_PUBLIC_URL=https://legalcareerist.ru/bot2
PORT=3002
