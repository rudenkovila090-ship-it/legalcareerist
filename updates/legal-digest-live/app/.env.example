# Скопируйте этот файл в .env и заполните. Файл .env никому не показывайте и не коммитьте.

# Шаг 1: my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Шаг 2: токен бота от @BotFather.
# Необязательно: без него сводка придёт в «Избранное» (но без push-уведомления).
BOT_TOKEN=

# Папки Telegram, из которых читаем каналы: одна или несколько через запятую,
# названия точно такие, как в Telegram. "*" = все каналы, на которые вы подписаны.
FOLDER_NAME=LawFirm, Law, LawPersonal, LawHR, LawEd

# Сколько дней назад читать при самом первом запуске
BACKFILL_DAYS=14
# Мероприятие попадает в сводку, когда до него осталось не больше стольких дней
HORIZON_DAYS=14

# Какие вакансии показывать: legal = только юридические (и офисные роли в юридической сфере:
# офис-менеджер, секретарь, ассистент), all = любые.
VACANCY_SCOPE=legal

# Новости о людях рынка старше стольких дней не берутся (сводка про свежее)
NEWS_DAYS=3

# Вакансии старше стольких дней не берутся: они обычно уже закрыты и лидом не будут
VACANCY_DAYS=7

# Необязательно, через запятую. ONLY_KEYWORDS: брать только посты с этими словами,
# EXCLUDE_KEYWORDS: выкидывать посты с этими словами. Пусто = без фильтра.
# Пример: ONLY_KEYWORDS=юрист,юридич,право,адвокат,legal
ONLY_KEYWORDS=
EXCLUDE_KEYWORDS=

# Необязательно: ваш числовой Telegram id, если сводку нужно слать не вам, а в другой чат.
# По умолчанию сводка приходит вам.
# OWNER_CHAT_ID=
